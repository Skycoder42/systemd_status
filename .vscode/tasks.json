{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "dart",
			"command": "dart",
			"args": [
				"run",
				"build_runner",
				"watch",
				"--workspace"
			],
			"problemMatcher": [],
			"label": "Build",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"runOptions": {
				"runOn": "folderOpen"
			}
		},
		{
			"type": "shell",
			"command": "docker",
			"options": {
				"cwd": "${workspaceFolder}/server"
			},
			"args": [
				"compose",
				"up",
				"-d"
			],
			"problemMatcher": [],
			"label": "Start systemd container",
		},
	]
}
